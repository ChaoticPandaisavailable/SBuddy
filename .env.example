# Copy to .env.local. SERVER ONLY: never use NEXT_PUBLIC_* or VITE_* for secrets.
AI_PROVIDER=aiping
AIPING_BASE_URL=https://aiping.cn/api/v1
AIPING_API_KEY=
AIPING_TEXT_MODEL=Qwen3-Next-80B-A3B-Instruct
AIPING_VISION_MODEL=Qwen3-VL-30B-A3B-Instruct
AIPING_IMAGE_MODEL=Doubao-Seedream-5.0-lite

# Independent speech service (does not require the Aiping key).
TRANSCRIBE_PROVIDER=moss
MOSS_BASE_URL=https://api.mosi.cn/v1
MOSS_API_KEY=
MOSS_TRANSCRIBE_MODEL=moss-transcribe-1.0

# Optional legacy provider: set AI_PROVIDER=openai and/or TRANSCRIBE_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2

NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
