# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=

# Cost-efficient text/JSON tasks: schedule parsing, summaries, and dialogue polish.
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Image understanding: detects people, describes complete appearance, validates rig parts, reads schedules.
# This model must accept image input and structured JSON output.
OPENAI_VISION_MODEL=gpt-5.4-mini

# Audio transcription is kept independent from the text and vision models.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Required for photo-to-character generation; default characters work without a service.
OPENAI_IMAGE_MODEL=gpt-image-2

# Used by social preview metadata in production.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
